/*
 * Brikken: AS3933 LF wake-up receiver over SPI
 *
 * ROTARSAKEN til at SPI ikke virket: konsollen (uart20) sitter pa
 * P1.04-P1.07, de samme pinnene SPI skulle bruke. UART-en drev
 * P1.06, sa MISO aldri kunne lese noe fra AS3933.
 *
 * Losning: konsollen flyttes til uart30 pa P0.00-P0.03, og uart20
 * slas av helt. Da frigjores P1.04-P1.07.
 *
 * MERK: konsollen bytter COM-port. Den gar fra COM5 til COM4
 * (serial port 0 i stedet for 1). VCOM1 kan sta frakoblet i
 * Board Configurator.
 *
 * AS3933 har AKTIV-HOY chip select - derfor GPIO_ACTIVE_HIGH pa
 * cs-gpios, og SPI_CS_ACTIVE_HIGH i koden.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
	};
};

/* Frigjor P1.04-P1.07 */
&uart20 {
	status = "disabled";
};

&uart30 {
	status = "okay";
	current-speed = <115200>;
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
				<NRF_PSEL(SPIM_MOSI, 1, 5)>,
				<NRF_PSEL(SPIM_MISO, 1, 6)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
				<NRF_PSEL(SPIM_MOSI, 1, 5)>,
				<NRF_PSEL(SPIM_MISO, 1, 6)>;
			low-power-enable;
		};
	};
};

&spi21 {
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";

	/* AKTIV HOY - ikke GPIO_ACTIVE_LOW */
	cs-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;

	as3933: as3933@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/ {
	as3933_gpio {
		compatible = "gpio-keys";

		as3933_wake: wake {
			gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "AS3933 WAKE";
		};
	};
};
